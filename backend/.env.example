LLM_BASE_URL=https://api.sarvam.ai/v1
# Sarvam API subscription key (dashboard.sarvam.ai)
LLM_API_KEY=
LLM_MODEL=sarvam-105b
# Tried in order when the main model is busy or its answers are unusable (comma-separated)
LLM_FALLBACK_MODELS=sarvam-105b-conversations
# Sarvam models reason before answering; low keeps a world recipe inside LLM_MAX_TOKENS
LLM_REASONING_EFFORT=low
LLM_DAILY_CAP=300
# Local only: do not set on Render free/ephemeral instances (the spend cap file resets on restart; see README)
MESHY_API_KEY=
MESHY_MAX_GENERATIONS=5
MESHY_REFINE=0
CORS_ORIGINS=*
LLM_JSON_MODE=1
POLY_PIZZA_KEY=
SKETCHFAB_TOKEN=
ASSET_LLM_PICK=1
ASSET_DAILY_CAP=500
ASSET_PICK_DAILY_CAP=200
