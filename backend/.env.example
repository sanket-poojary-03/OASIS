LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
# Tried in order when the main model is busy (comma-separated)
LLM_FALLBACK_MODELS=google/gemini-2.5-flash
LLM_DAILY_CAP=300
# Local only: do not set on Render free/ephemeral instances (the spend cap file resets on restart; see README)
MESHY_API_KEY=
MESHY_MAX_GENERATIONS=5
MESHY_REFINE=0
CORS_ORIGINS=*
LLM_JSON_MODE=1
POLY_PIZZA_KEY=
SKETCHFAB_TOKEN=
ASSET_LLM_PICK=1
ASSET_DAILY_CAP=500
ASSET_PICK_DAILY_CAP=200
